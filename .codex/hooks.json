{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CODEX_PROJECT_DIR}/hook_launcher.py\" --host codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CODEX_PROJECT_DIR}/hook_launcher.py\" --host codex"
          }
        ]
      }
    ]
  }
}
