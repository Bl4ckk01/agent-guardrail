{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/hook_launcher.py\" --host claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/hook_launcher.py\" --host claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|Grep|NotebookRead|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/hook_launcher.py\" --host claude"
          }
        ]
      }
    ]
  }
}
